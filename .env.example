# Postgres (Vercel Marketplace > Neon adds POSTGRES_URL automatically)
POSTGRES_URL=postgres://user:password@host/db?sslmode=require

# Vercel Blob (Storage tab > Create Blob store)
BLOB_READ_WRITE_TOKEN=

# OpenAI: transcription (whisper-1) and embeddings for "search by meaning"
OPENAI_API_KEY=

# Google Cloud Translation API key (Nepali / Nepal Bhasa -> English). Optional.
GOOGLE_TRANSLATE_API_KEY=

# The single admin account
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me-to-a-long-password

# Random string used to sign admin session cookies (openssl rand -base64 32)
SESSION_SECRET=replace-with-random-string
